---
import '@styles/global.css';
import Header from '@components/Header.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
    title?: string;
    description?: string;
    keywords?: string;
    ogType?: string;
    lang?: string;
    isStickyHeader?: boolean;
}

const {
    title = 'Rise and Fall: Civilizations at War',
    description,
    keywords,
    ogType = 'website',
    lang = Astro.params.lang || 'en',
    isStickyHeader = true,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url).href;
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://kotop21.github.io';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
let pathWithoutLang = Astro.url.pathname.replace(new RegExp(`^${base}/(en|ru)`), '');
if (!pathWithoutLang.endsWith('/')) pathWithoutLang += '/';
const urlRu = `${siteUrl}${base}/ru${pathWithoutLang}`;
const urlEn = `${siteUrl}${base}/en${pathWithoutLang}`;
const previewImage = `${siteUrl}${base}/preview.png`;

const jsonLd = {
    "@context": "https://schema.org",
    "@type": ogType === 'article' ? 'Article' : 'WebPage',
    "name": title,
    ...(description ? { "description": description } : {}),
    "url": canonicalURL,
    "inLanguage": lang,
    "isPartOf": {
        "@type": "WebSite",
        "name": "Rise and Fall: Civilizations at War",
        "url": `${siteUrl}${base}/${lang}/`
    }
};
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        {description && <meta name="description" content={description} />}
        {keywords && <meta name="keywords" content={keywords} />}
        <meta name="robots" content="index, follow, max-image-preview:large" />
        <meta name="google-site-verification" content="google90f0b83446a4d2c3" />

        <meta property="og:site_name" content="Rise and Fall: Civilizations at War" />
        <meta property="og:title" content={title} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={previewImage} />
        <meta property="og:image:alt" content={title} />
        <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
        <meta property="og:locale:alternate" content={lang === 'ru' ? 'en_US' : 'ru_RU'} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        {description && <meta name="twitter:description" content={description} />}
        <meta name="twitter:image" content={previewImage} />

        <link rel="canonical" href={canonicalURL} />
        <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
        
        <link rel="alternate" hreflang="ru" href={urlRu} />
        <link rel="alternate" hreflang="en" href={urlEn} />
        <link rel="alternate" hreflang="x-default" href={urlEn} />

        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

        <ClientRouter />
        <slot name="head" />
    </head>
    <body>
        <Header isSticky={isStickyHeader} lang={lang} />
        <div id="page-preloader" class="preloader-overlay" transition:persist="preloader" aria-hidden="true">
            <div class="spinner"></div>
        </div>
        <div id="page-content">
            <slot />
        </div>

        <script>
            (() => {
                let safetyTimer: ReturnType<typeof setTimeout> | null = null;
                let spinnerTimer: ReturnType<typeof setTimeout> | null = null;
                let isLanguageTransition = false;

                const getPreloader = () => document.getElementById('page-preloader');
                const getContent = () => document.getElementById('page-content');

                const showSpinner = () => {
                    if (safetyTimer) clearTimeout(safetyTimer);
                    const el = getPreloader();
                    if (el) {
                        el.classList.remove('is-hidden');
                        safetyTimer = setTimeout(hideSpinner, 3500);
                    }
                };

                const hideSpinner = () => {
                    if (safetyTimer) {
                        clearTimeout(safetyTimer);
                        safetyTimer = null;
                    }
                    if (spinnerTimer) {
                        clearTimeout(spinnerTimer);
                        spinnerTimer = null;
                    }
                    const el = getPreloader();
                    if (el) el.classList.add('is-hidden');
                };

                // Cold start: hide when window and resources are fully ready
                if (document.readyState === 'complete') {
                    hideSpinner();
                } else {
                    window.addEventListener('load', hideSpinner, { once: true });
                    safetyTimer = setTimeout(hideSpinner, 3000);
                }

                // Detect language switch clicks in capture phase before Astro ClientRouter
                document.addEventListener('click', (e) => {
                    const target = (e.target as HTMLElement)?.closest('a');
                    if (target && target.hasAttribute('data-lang-switch')) {
                        isLanguageTransition = true;
                    }
                }, true);

                // Astro ClientRouter page transitions
                document.addEventListener('astro:before-preparation', (event: any) => {
                    const isMobile = window.innerWidth <= 768;
                    const sourceEl = event.sourceElement as HTMLElement | undefined;
                    const fromPath = event.from?.pathname || '';
                    const toPath = event.to?.pathname || '';
                    const normalizePath = (p: string) => p.replace(/\/(ru|en)(\/|$)/, '/');

                    const isLang = isLanguageTransition || 
                        Boolean(sourceEl?.closest('[data-lang-switch]')) ||
                        (Boolean(fromPath) && Boolean(toPath) && normalizePath(fromPath) === normalizePath(toPath));

                    // On mobile OR during language switch: NO fade-out, NO artificial delay!
                    if (isMobile || isLang) {
                        document.documentElement.classList.add(isLang ? 'no-lang-transition' : 'no-fade-transition');
                        return;
                    }

                    if (spinnerTimer) clearTimeout(spinnerTimer);

                    // Normal desktop page/tab transitions (Home <-> Wiki): smooth fade-in/fade-out
                    const content = getContent();
                    if (content) {
                        content.classList.add('page-fading-out');
                    }

                    const originalLoader = event.loader;
                    event.loader = async () => {
                        const fadePromise = new Promise(resolve => setTimeout(resolve, 120));
                        await Promise.all([originalLoader(), fadePromise]);
                    };

                    spinnerTimer = setTimeout(() => {
                        showSpinner();
                    }, 140);
                });

                document.addEventListener('astro:after-swap', () => {
                    hideSpinner();
                    document.documentElement.classList.remove('no-lang-transition');
                    document.documentElement.classList.remove('no-fade-transition');
                    isLanguageTransition = false;
                });

                document.addEventListener('astro:page-load', () => {
                    hideSpinner();
                    document.documentElement.classList.remove('no-lang-transition');
                    document.documentElement.classList.remove('no-fade-transition');
                    isLanguageTransition = false;
                    const content = getContent();
                    if (content) {
                        content.classList.remove('page-fading-out');
                    }
                });

                // Smooth scrolling only for in-page anchor links (e.g. Table of Contents in Wiki)
                document.addEventListener('click', (e) => {
                    const anchor = (e.target as HTMLElement)?.closest('a[href^="#"]');
                    if (!anchor) return;
                    const href = anchor.getAttribute('href');
                    if (href && href.length > 1) {
                        const target = document.querySelector(href);
                        if (target) {
                            e.preventDefault();
                            target.scrollIntoView({ behavior: 'smooth' });
                            history.pushState(null, '', href);
                        }
                    }
                });
            })();
        </script>
    </body>
</html>
