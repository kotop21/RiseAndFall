---
const siteUrl = 'https://kotop21.github.io';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalEn = `${siteUrl}${base}/en/`;
const alternateRu = `${siteUrl}${base}/ru/`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Rise and Fall: Civilizations at War</title>
        <meta name="description" content="Rise and Fall: Civilizations at War community hub. Knowledge base, ranking, and guides." />
        <meta name="robots" content="noindex, follow" />
        <meta name="google-site-verification" content="google90f0b83446a4d2c3" />
        <link rel="canonical" href={canonicalEn} />
        <link rel="alternate" hreflang="en" href={canonicalEn} />
        <link rel="alternate" hreflang="ru" href={alternateRu} />
        <link rel="alternate" hreflang="x-default" href={canonicalEn} />
        <meta http-equiv="refresh" content={`0;url=${base}/en/`} />
        <script define:vars={{ base }}>
            if (typeof window !== 'undefined') {
                window.location.replace(`${base}/en/`);
            }
        </script>
    </head>
    <body style="background: #0F0F0F; color: #EAEAEA; font-family: ui-monospace, monospace; padding: 2rem; text-align: center;">
        <p>Redirecting to <a href={`${base}/en/`} style="color: #C5A059;">English</a> / <a href={`${base}/ru/`} style="color: #C5A059;">Русский</a>...</p>
    </body>
</html>
