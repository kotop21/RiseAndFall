---
interface Props {
  text: string;
  thanksTitle?: string;
  thanksSkip?: string;
}

const {
  text,
  thanksTitle = 'Спасибо за скачивание! ❤️',
  thanksSkip = 'Пропустить'
} = Astro.props;

const fallbackUrl = 'https://github.com/kotop21/RiseAndFall---launcher/releases/latest';
---

<a
  href={fallbackUrl}
  class="download-button"
  data-download-launcher
  target="_blank"
  rel="noopener noreferrer"
>
  <span>{text}</span>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"></path>
  </svg>
</a>

<div class="thanks-backdrop" id="thanks-modal" aria-hidden="true">
  <div class="thanks-modal">
    <h3 class="thanks-title">{thanksTitle}</h3>
    <button type="button" class="thanks-skip-btn">{thanksSkip}</button>
  </div>
</div>

<script>
  import { initLauncherDownload } from '../utils/launcher';
  initLauncherDownload();

  const modal = document.getElementById('thanks-modal');
  const downloadBtns = document.querySelectorAll('[data-download-launcher]');
  const skipBtn = modal?.querySelector('.thanks-skip-btn');

  let hideTimer: any = null;

  function showModal() {
    if (!modal) return;
    modal.classList.add('is-visible');
    modal.setAttribute('aria-hidden', 'false');

    if (hideTimer) clearTimeout(hideTimer);
    hideTimer = setTimeout(hideModal, 6000);
  }

  function hideModal() {
    if (!modal) return;
    modal.classList.remove('is-visible');
    modal.setAttribute('aria-hidden', 'true');
    if (hideTimer) {
      clearTimeout(hideTimer);
      hideTimer = null;
    }
  }

  downloadBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      showModal();
    });
  });

  skipBtn?.addEventListener('click', hideModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      hideModal();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('is-visible')) {
      hideModal();
    }
  });
</script>

<style>
  .thanks-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: grid;
    place-items: center;
    z-index: 99999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    padding: 1.5rem;
    box-sizing: border-box;
  }

  .thanks-backdrop.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .thanks-modal {
    border-radius: 12px;
    padding: 2.2rem 2rem;
    max-width: 440px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.8rem;
    margin: auto;
    transform: scale(0.94) translateY(12px);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .thanks-backdrop.is-visible .thanks-modal {
    transform: scale(1) translateY(0);
  }

  .thanks-title {
    color: #fff;
    font-size: 1.3rem;
    margin: 0;
    font-weight: bold;
    letter-spacing: 0.02em;
    white-space: nowrap;
    text-align: center;
    font-size: 35px;
  }

  .thanks-desc {
    color: #A1A1AA;
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
    text-align: center;
  }

  .thanks-skip-btn {
    background: transparent;
    border: none !important;
    color: #666;
    font-size: 0.85rem;
    font-family: inherit;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    padding: 0.4rem 1rem;
    margin-top: 0.5rem;
    transition: color 0.2s ease;
    text-align: center;
  }

  .thanks-skip-btn:hover {
    color: var(--accent);
  }
</style>
