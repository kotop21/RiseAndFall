---
import DownloadButton from '@components/DownloadButton.astro';
---
<header>
    <h1>Rise and Fall:<br>Civilizations at War</h1>
    <p>The single entry point to the world of Rise & Fall. Official community hub: up-to-date knowledge base, global player rankings, and step-by-step guides.</p>
    
    <div class="hero-actions">
        <DownloadButton text="Download Launcher" />
        <nav class="secondary-nav">
            <a href="https://github.com/kotop21/RiseAndFall" target="_blank">GitHub</a>
            <a href="https://discord.gg/EKTAsxemqf" target="_blank">Discord</a>
        </nav>
    </div>
</header>

<div>
    <section>
        <h2>🎮 How to start playing</h2>
        <div class="step-list">
            <div class="step"><div class="step-num">01</div><div class="step-text">Download the launcher from GitHub.</div></div>
            <div class="step"><div class="step-num">02</div><div class="step-text">Download the game via launcher + install the <strong>balance fix</strong>.</div></div>
            <div class="step"><div class="step-num">03</div><div class="step-text">Install <strong>dgVoodoo</strong> (included in the launcher).</div></div>
            <div class="step"><div class="step-num">04</div><div class="step-text">Click <code>Connect to Network</code>.</div></div>
        </div>
    </section>
    <section>
        <h2>🏆 Ranked games (1v1)</h2>
        <div class="alert" style="padding: 0.9rem 1.5rem;">Recording the match is strictly mandatory for both players.</div>
        <div class="step-list">
            <div class="step"><div class="step-num">01</div><div class="step-text">Join our Discord.</div></div>
            <div class="step"><div class="step-num">02</div><div class="step-text">Register: <code>/register [your_nickname]</code></div></div>
            <div class="step"><div class="step-num">03</div><div class="step-text">Challenge: <code>/duel @nickname</code></div></div>
            <div class="step"><div class="step-num">04</div><div class="step-text">Best of 3 matches.</div></div>
            <div class="step"><div class="step-num">05</div><div class="step-text">Submit video via <code>/report</code>.</div></div>
        </div>
    </section>
</div>
<footer><hr /><p>Created by: xxds ❤️</p></footer>
