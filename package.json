{
  "name": "my-astro-project-using-bun",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "bundlesize": [
    {
      "path": "./dist/**/*.html",
      "maxSize": "14 kB"
    }
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && bundlesize",
    "preview": "astro preview",
    "preview:host": "astro preview --host",
    "start": "bun run build && bun run preview",
    "start:host": "bun run build && astro preview --host",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.1.6"
  },
  "devDependencies": {
    "bundlesize2": "^0.0.35",
    "typescript": "^6.0.2"
  }
}
